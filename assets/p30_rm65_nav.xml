<mujoco model="p30_rm65_nav">
  <!-- 自动派生，勿手改。生成器：make_nav_scene.py （源：p30_rm65_scene.xml） -->
  <!-- 自动生成，勿手改。生成器：build_scene.py -->
  <!-- eulerseq 必须是 zyx：机械臂各 body 的 euler 值是从旧 rm65_grasp.xml
       原样搬过来的，那套值按 zyx 解读才对应 RM65 的真实构型。
       漏掉这句时 MuJoCo 默认按 xyz 解读，每个连杆初始旋转全错，
       视觉上表现为「关节扭曲、连杆错位」。
       实测（diag_sdk_fk.py）：zyx 下正解与 REALMAN SDK 误差 0.0000 m，
       默认 xyz 累计误差 5.49 m。 -->
  <compiler angle="radian" eulerseq="zyx" autolimits="true" meshdir="meshes"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast" cone="elliptic"/>

  <visual>
    <!-- 过曝会毁掉颜色条件：ambient 与 diffuse 之和要留余量，
         否则白台面反射后整体亮度接近 1，彩色方块被冲白、饱和度掉到 0.07。 -->
    <headlight ambient="0.18 0.18 0.20" diffuse="0.42 0.42 0.44" specular="0.05 0.05 0.05"/>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
  </visual>

  <default>
    <joint armature="0.05" damping="0.5"/>
    <geom contype="1" conaffinity="1" friction="0.9 0.02 0.001"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
    <!-- 碰撞代理放 group 3：viewer 默认只开 0/1/2，这样看到的是真实 mesh。
         之前代理留在 group 0，胶囊比真实连杆粗（RM65 半径 4.5~5cm），
         把 mesh 整个包住，屏幕上只剩一堆管子。 -->
    <default class="arm">
      <geom contype="2" conaffinity="1" group="3"/>
    </default>
    <default class="cube">
      <geom type="box" size="0.03 0.03 0.03" friction="1.5 0.05 0.001"
            condim="4" contype="1" conaffinity="1"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.65 0.78" rgb2="0.28 0.32 0.38"
             width="512" height="3072"/>
    <texture type="2d" name="floor_tex" builtin="checker" mark="edge"
             rgb1="0.72 0.72 0.74" rgb2="0.62 0.62 0.65"
             markrgb="0.55 0.55 0.58" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="8 8" reflectance="0.08"/>
    <texture type="2d" name="table_tex" builtin="checker" mark="edge"
             rgb1="0.80 0.78 0.74" rgb2="0.74 0.72 0.68"
             markrgb="0.70 0.68 0.64" width="256" height="256"/>
    <material name="table_mat" texture="table_tex" texuniform="true" texrepeat="3 3" reflectance="0.15"/>

    <!-- P30W 官方简化 mesh（左右镜像用 asset 级 scale，MuJoCo 3.x 不支持 geom scale）-->
    <mesh name="trunk_vis" file="TRUNK.STL"/>
    <mesh name="hip_L"    file="FL_HIP.STL"/>
    <mesh name="hip_R"    file="FL_HIP.STL" scale="1 -1 1"/>
    <mesh name="thigh_L"  file="FL_THIGH.STL"/>
    <mesh name="thigh_R"  file="FL_THIGH.STL" scale="1 -1 1"/>
    <mesh name="calf_L"   file="FL_CALF.STL"/>
    <mesh name="calf_R"   file="FL_CALF.STL" scale="1 -1 1"/>
    <mesh name="wheel_L"  file="FL_WHEEL.STL"/>
    <mesh name="wheel_R"  file="FL_WHEEL.STL" scale="1 -1 1"/>

    <!-- RM65 -->
    <mesh name="rm65_base" file="rm65/base_link.STL"/>
    <mesh name="rm65_l1" file="rm65/link1.STL"/>
    <mesh name="rm65_l2" file="rm65/link2.STL"/>
    <mesh name="rm65_l3" file="rm65/link3.STL"/>
    <mesh name="rm65_l4" file="rm65/link4.STL"/>
    <mesh name="rm65_l5" file="rm65/link5.STL"/>
    <mesh name="rm65_l6" file="rm65/link6.STL"/>
    <!-- Dex1-1 夹爪 -->
    <mesh name="dex_base" file="dex1_1/base_link.STL"/>
    <mesh name="dex_l1_1" file="dex1_1/Link1_1.STL"/>
    <mesh name="dex_l1_2" file="dex1_1/Link1_2.STL"/>
    <mesh name="dex_l1_3" file="dex1_1/Link1_3.STL"/>
    <mesh name="dex_l2_1" file="dex1_1/Link2_1.STL"/>
    <mesh name="dex_l2_2" file="dex1_1/Link2_2.STL"/>
  </asset>
<worldbody>
