          rgba="0.44 0.44 0.48 1" contype="1" conaffinity="1" condim="3"/>
  </body>

  <!-- ===== P30W 机器狗（固定基座；腿部关节保留但无驱动器）===== -->
  <!-- ===== 底盘：运动学挂载（SE(2)）===== -->
  <!-- 三个 joint 挂同一个 body，顺序即 qpos 顺序：x → y → yaw。
       速度由下方 base_vx/base_vy/base_wz 三个 velocity 执行器给，
       位置由 MuJoCo 积分 —— 与 P30 SendVelocity 语义一致。 -->
  <body name="base_planar" pos="0 0 0">
    <joint name="base_slide_x" type="slide" axis="1 0 0" range="-3.000 3.000"/>
    <joint name="base_slide_y" type="slide" axis="0 1 0" range="-2.400 2.400"/>
    <joint name="base_hinge_z" type="hinge" axis="0 0 1"/>
    <!-- 带 joint 的 body 必须有正质量/惯量，否则 MuJoCo 直接报错。
         取 0.01 kg / 1e-4 量级，对总质量 (~38 kg) 无影响。 -->
    <inertial pos="0 0 0" mass="0.01" diaginertia="1e-4 1e-4 1e-4"/>
        <body name="base_link" pos="0 0 0.6">
          <inertial pos="0.0001 -0.012 0.012" mass="21.749"
                    fullinertia="0.1720 0.7258 0.7710 0.0000134 -0.00287 -0.00315"/>
          <geom class="visual" type="mesh" mesh="trunk_vis" rgba="0.18 0.22 0.20 1"/>
          <!-- 躯干碰撞盒：顶面必须等于实测躯干最高点 0.754（local 0.154），
               否则臂基座 z=0.78 会嵌在虚高的碰撞盒里，侧向摆动全被判干涉。 -->
          <geom name="trunk_col" class="arm" type="box" pos="-0.005 0 0.015"
                size="0.40 0.14 0.139" rgba="0.18 0.22 0.20 1"/>
          <site name="imu" pos="0 0 0" size="0.01" rgba="1 0.5 0 1"/>

          <!-- 上装转接板：底面贴躯干顶面、顶面托住机械臂底座，板厚 26mm。
               z 由 ADAPTER_MID_Z 推出，保证「躯干 → 板 → 臂底座」三者严丝合缝；
               手写死数值极易再出现 13mm 悬空。 -->
          <geom name="adapter_plate" class="arm" type="box"
                pos="0.06 0.0 0.10249999999999992"
                size="0.14 0.1095 0.0075"
                rgba="0.35 0.35 0.38 1"/>

          <!-- 狗前方相机（front_cam）：装在 TRUNK.STL 前脸的内凹面板里。
               === 位置依据（2026-11-10 用户实拍照片 + STL 实测）===
               用户拍了 P30 前脸实物照片并圈出那块黑色面板，确认相机在那里。
               TRUNK.STL 上对应的是一块正对 +x 的平板：
                 x  = 389.7 ~ 390.0 mm      （前脸最前沿）
                 y  = -59.0 ~ +58.3 mm      （宽 117 mm，居中对称）
                 z  = +14.5 ~ +81.7 mm      （高 67 mm）
               117 x 67 mm 是双目深度模组的典型开口；面板后方 x~355mm 处有一圈
               -x 朝向的背板，构成 35 mm 深的内凹安装槽。
               相机取面板中心 z=+0.0481（局部），x=0.3900（与面板齐平）。

               === 为什么删掉 cam_mast ===
               原 head_cam 立在自造立柱顶端（局部 z=0.240），而 TRUNK.STL 最高只有
               0.1536 —— 那根杆高出去 66.4 mm，真机上没有这个硬件。现改为真机的
               front_0（Gemini 336L，27 x 124 x 29 mm），立柱整根删除。

               === 朝向：正前方（+x）、下俯 45°，fovy 70（真机内参待标定）===
               实测（目标在 (0.46,0)，joint6=-90°，姿态 settle 150 步后）：
                 俯角   PRE目标   GRASP目标   GRASP自遮挡
                  20°   26.07%     8.03%       81.0%
                  30°   35.21%    19.45%       73.6%
                  45°   42.59%    27.11%       58.7%   <- 选中
                  50°   41.50%    25.34%       53.7%
               45° 是「深处看得见」与「自遮挡不过半」的拐点，再俯就只看到桌面。

               === 测量陷阱 ===
               只在模型里写 qpos、不 settle 就渲染，会得到偏乐观的数字（同一姿态
               0.71% vs 0.00%）。抓取位夹爪要压到方块高度，必须 step 到稳态。

               === 滚转必须用 xyaxes 显式给 ===
               只写 zaxis 时 MuJoCo 自己补 right（实测画面被转了 90°，四个方块竖着
               排）。这里显式指定画面右 = 世界 -y（狗朝 +x 时的正常装法）。

               MuJoCo 相机约定：zaxis 是 cam_xmat 第 3 列，前向 = -zaxis；
               xyaxes 是前两列 (right, up)，右乘关系 right x up = -forward。 -->
          <camera name="front_cam" pos="0.3900 0.0000 0.0481"
                  xyaxes="0 -1 0 0.7071 0 0.7071" fovy="70"/>

